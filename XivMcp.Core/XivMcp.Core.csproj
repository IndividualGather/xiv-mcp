<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game-independent logic of XIV MCP (tool registry, permissions, audit, jobs helpers, plugin protocol).
       No Dalamud or game references, so everything here is unit tested in XivMcp.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>XivMcp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XivMcp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The stdio bridge packed into the Claude Desktop extension (ClientSetup.WriteMcpb). -->
    <EmbeddedResource Include="Connect/bridge.js" />
  </ItemGroup>
</Project>
