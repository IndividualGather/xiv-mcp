<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.0</Version>
    <Description>Connects AI assistants to Final Fantasy XIV through a local Model Context Protocol (MCP) server: live character data, retainers, submersibles, inventory management and plugin management.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game-independent logic, unit tested in XivMcp.Tests. -->
    <ProjectReference Include="..\XivMcp.Core\XivMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dalamud shows images/icon.png next to the DLL as the plugin icon. Regenerate with images/draw-icon.ps1. -->
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Link="images\icon.png" />
    <None Remove="images\draw-icon.ps1" />
    <!-- Logos of AI apps that aren't installed, for the Connect tab (see branding/apps). -->
    <Content Include="images\apps\*.png" CopyToOutputDirectory="PreserveNewest" Link="images\apps\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
